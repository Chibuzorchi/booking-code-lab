+/* Shared by the live console and both standalone reports; inlined for file://. */
+:root {
+  --space-1:4px; --space-2:8px; --space-3:12px; --space-4:16px;
+  --space-6:24px; --space-8:32px;
+  --ink:#1d2523; --muted:#58645f; --accent:#205b46;
+  --surface:#fff; --canvas:#f5f6f5; --line:#d8dedb;
+  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
+  font-size:16px; line-height:1.5; color:var(--ink); background:var(--canvas); color-scheme:light;
+}
+* {box-sizing:border-box}
+[hidden] {display:none!important}
+body {margin:0}
+button,input,select,textarea {font:inherit}
+button,input,select,textarea,a,summary {touch-action:manipulation}
+button,input,select,textarea {min-width:44px; min-height:44px; border-radius:8px}
+button,.button {padding:var(--space-2) var(--space-4); border:1px solid var(--line); background:var(--surface); color:var(--accent); font-weight:600; cursor:pointer; min-width:44px; min-height:44px}
+input,select {max-width:100%; padding:var(--space-2) var(--space-3); border:1px solid #aab6af; background:var(--surface); color:var(--ink)}
+button.go,.allbtn {background:var(--accent); border-color:var(--accent); color:#fff}
+button.quiet {background:transparent; border-color:transparent}
+button:disabled,button:disabled:hover,input:disabled,select:disabled {
+  opacity:.45; cursor:not-allowed; box-shadow:none; filter:none;
+}
+fieldset:disabled button {cursor:not-allowed}
+:where(button,input,select,textarea,a,summary):focus-visible {outline:3px solid #2878c8; outline-offset:3px}
+@media(hover:hover) {
+  button:enabled:hover {filter:brightness(.94)}
+  summary:hover {background:#f0f4f1}
+}
+summary {min-width:44px; min-height:44px; padding:var(--space-3) 0; cursor:pointer}
+a {display:inline-flex; align-items:center; min-width:44px; min-height:44px}
+header {background:var(--surface); color:var(--ink); padding:var(--space-8) max(24px,calc((100vw - 1072px)/2))}
+header p {color:var(--muted); max-width:760px; margin:0; line-height:1.5}
+header a {color:var(--accent)}
+.eyebrow {color:var(--muted); font-size:12px; font-weight:600; letter-spacing:.08em; text-transform:uppercase}
+h1 {font-size:32px; font-weight:650; line-height:1.2; letter-spacing:-.025em; margin:var(--space-2) 0 var(--space-4)}
+h2 {font-size:24px; font-weight:650; line-height:1.25; letter-spacing:-.02em; margin:0 0 var(--space-2)}
+h3 {font-size:18px; line-height:1.4; font-weight:600; margin:var(--space-6) 0 var(--space-2)}
+h4 {font-size:16px; line-height:1.5; font-weight:600; margin:var(--space-4) 0 var(--space-2)}
+p {line-height:1.5}
+main {max-width:1120px; margin:auto; padding:var(--space-6) var(--space-6) 64px}
+.panel {background:var(--surface); border:0; border-radius:16px; margin-bottom:var(--space-6); padding:var(--space-8); box-shadow:0 1px 3px #172a2010}
+.panel[aria-disabled=true] {opacity:1}
+.panel[aria-disabled=true] .step {background:#e7ebe8; color:var(--muted)}
+.notice,.footer,td small {color:var(--muted); font-size:14px; line-height:1.5}
+.notice {margin:var(--space-2) 0 0}
+label {display:flex; flex-direction:column; gap:var(--space-2); font-size:14px; font-weight:600; min-width:0}
+label span {color:var(--muted); font-size:12px; font-weight:400}
+.grid,.controls,.bar,.list-top,.detail-top {gap:var(--space-4)}
+.grid {display:flex; align-items:end; flex-wrap:wrap; margin-top:var(--space-4)}
+.grid>label {flex:1 1 160px}
+.facts {display:flex; flex-wrap:wrap; gap:var(--space-6); margin:var(--space-6) 0; padding:0; list-style:none}
+.facts li {background:transparent; border:0; padding:0; min-width:104px}
+.facts b {display:block; font-size:12px; text-transform:none; letter-spacing:0; color:var(--muted); font-weight:500}
+.facts span {font-size:24px; font-weight:600; font-variant-numeric:tabular-nums}
+.ticket {background:var(--surface); border:0; border-bottom:1px solid var(--line); border-radius:0; margin:0}
+.ticket summary {padding:var(--space-4) 0; gap:var(--space-4)}
+.ticket[open] summary {background:transparent; border-bottom:0}
+.ticket summary small,summary small,th {font-size:12px; color:var(--muted); text-transform:none; letter-spacing:0}
+.ticket summary strong {font-size:16px}
+.detail {padding:var(--space-4); overflow-x:auto}
+.scroll {max-width:100%; overflow:auto}
+th {background:transparent; font-weight:600}
+th,td {padding:var(--space-3) var(--space-2); border-bottom:1px solid #e7ebe8}
+table {border-collapse:collapse; width:100%; text-align:left; font-size:14px}
+.n {font-variant-numeric:tabular-nums}
+details.more {margin-top:var(--space-4)}
+details.more>summary,.footer summary {font-size:14px; font-weight:600; color:var(--accent)}
+@media(max-width:700px) {
+  header {padding:var(--space-6) var(--space-4)}
+  h1 {font-size:28px} h2 {font-size:22px}
+  main {padding:var(--space-4) var(--space-3) var(--space-8)}
+  .panel {padding:var(--space-6) var(--space-4)}
+  .grid>label {flex-basis:100%}
+  input,select {width:100%; font-size:16px}
+  .ticket summary {padding:var(--space-4) 0; gap:var(--space-3)}
+}
+@media(prefers-reduced-motion:reduce) {*,*::before,*::after {scroll-behavior:auto!important; transition:none!important; animation:none!important}}
